<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Blink.App</RootNamespace>
    <AssemblyName>Blink.App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms 타입은 'Forms.' alias로만 사용한다. 전역 using이 비접두 이름까지
         끌어와 System.Windows(WPF)와 충돌하므로 WinForms 네임스페이스만 제거 -->
    <Using Remove="System.Windows.Forms" />
    <!-- UseWindowsForms가 주입하는 전역 'System.Drawing'도 제거: Brush/Color가
         System.Windows.Media와 모호(CS0104)해진다. System.Drawing은 트레이 아이콘에서
         정규화 이름(System.Drawing.SystemIcons)으로만 사용한다. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blink.Core\Blink.Core.csproj" />
  </ItemGroup>
</Project>
