<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Blink.App</RootNamespace>
    <AssemblyName>Blink.App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms 타입은 'Forms.' alias로만 사용한다. 전역 using이 비접두 이름까지
         끌어와 System.Windows(WPF)와 충돌하므로 WinForms 네임스페이스만 제거 -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blink.Core\Blink.Core.csproj" />
  </ItemGroup>
</Project>
