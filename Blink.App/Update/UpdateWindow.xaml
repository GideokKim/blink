<!-- Blink.App (WPF, Windows-only). NOT built on macOS — verify on Windows.
     Update offer dialog: current → new version, release notes, one-click install. -->
<Window x:Class="Blink.App.Update.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blink — 업데이트"
        Width="560" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/blink.ico"
        FontFamily="{DynamicResource Blink.Sora}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource Blink.Sora}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Blink.Txt}"/>
            <Setter Property="Background" Value="{DynamicResource Blink.Tile}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blink.TileLine}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="hover" CornerRadius="9"
                                        Background="{DynamicResource Blink.RowHover}" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillBtnPrimary" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="{DynamicResource Blink.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blink.Accent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="PillBtnGhost" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blink.HairlineStrong}"/>
        </Style>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Blink.TxtDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Blink.RowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blink.Txt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Margin="20"
            Background="{DynamicResource Blink.Surface}"
            BorderBrush="{DynamicResource Blink.HairlineStrong}" BorderThickness="1"
            TextElement.Foreground="{DynamicResource Blink.Txt}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="14" Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Border CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0" Height="46" Background="{DynamicResource Blink.Titlebar}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="16,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center"
                               Source="pack://application:,,,/blink.ico"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0"
                                   FontSize="13.5" FontWeight="SemiBold">
                            <Run Text="Blink" Foreground="{DynamicResource Blink.Txt}"/><Run Text="  — 업데이트" Foreground="{DynamicResource Blink.TxtFaint}" FontWeight="Normal"/>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource WinBtn}" Click="Close_Click" ToolTip="닫기">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round"
                                  Data="M4,4 L10,10 M10,4 L4,10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Header: version transition -->
                <StackPanel Grid.Row="1" Margin="28,22,28,0">
                    <TextBlock Text="새 버전이 나왔습니다" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Blink.Txt}"/>
                    <TextBlock x:Name="VersionText" FontFamily="{DynamicResource Blink.Mono}"
                               FontSize="13" Foreground="{DynamicResource Blink.TxtDim}" Margin="0,7,0,0"/>
                </StackPanel>

                <!-- Release notes -->
                <Border Grid.Row="2" Margin="28,16,28,0" CornerRadius="13"
                        Background="{DynamicResource Blink.Inset}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10">
                        <StackPanel x:Name="NotesPanel"/>
                    </ScrollViewer>
                </Border>

                <!-- Download progress (hidden until 지금 업데이트) -->
                <Grid x:Name="ProgressArea" Grid.Row="3" Margin="28,14,28,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" FontSize="12"
                                   Foreground="{DynamicResource Blink.TxtDim}" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="DownloadBar" Height="4" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                     Background="{DynamicResource Blink.Inset}"
                                     Foreground="{DynamicResource Blink.Accent}" BorderThickness="0"/>
                    </StackPanel>
                    <Button x:Name="CancelBtn" Grid.Column="1" Style="{StaticResource PillBtnGhost}"
                            Content="취소" Margin="12,0,0,0" VerticalAlignment="Center" Click="Cancel_Click"/>
                </Grid>

                <!-- Footer buttons -->
                <Border Grid.Row="4" Margin="0,16,0,0" Background="{DynamicResource Blink.Surface2}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,1,0,0">
                    <Grid Margin="28,16">
                        <Button x:Name="SkipBtn" Style="{StaticResource PillBtnGhost}" Content="이 버전 건너뛰기"
                                HorizontalAlignment="Left" Click="Skip_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="LaterBtn" Style="{StaticResource PillBtnGhost}" Content="나중에"
                                    Margin="0,0,10,0" Click="Close_Click"/>
                            <Button x:Name="UpdateBtn" Style="{StaticResource PillBtnPrimary}" Content="지금 업데이트"
                                    Click="UpdateNow_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
