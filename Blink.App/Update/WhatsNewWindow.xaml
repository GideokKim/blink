<!-- Blink.App (WPF, Windows-only). NOT built on macOS — verify on Windows.
     Post-update "새로워진 점" window: release notes of the version just installed. -->
<Window x:Class="Blink.App.Update.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blink — 새로워진 점"
        Width="520" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/blink.ico"
        FontFamily="{DynamicResource Blink.Sora}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PillBtnPrimary" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource Blink.Sora}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource Blink.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Blink.Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="hover" CornerRadius="9"
                                        Background="{DynamicResource Blink.RowHover}" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Blink.TxtDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Blink.RowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blink.Txt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Margin="20"
            Background="{DynamicResource Blink.Surface}"
            BorderBrush="{DynamicResource Blink.HairlineStrong}" BorderThickness="1"
            TextElement.Foreground="{DynamicResource Blink.Txt}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="14" Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Border CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0" Height="46" Background="{DynamicResource Blink.Titlebar}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="16,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center"
                               Source="pack://application:,,,/blink.ico"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0"
                                   FontSize="13.5" FontWeight="SemiBold">
                            <Run Text="Blink" Foreground="{DynamicResource Blink.Txt}"/><Run Text="  — 새로워진 점" Foreground="{DynamicResource Blink.TxtFaint}" FontWeight="Normal"/>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource WinBtn}" Click="Close_Click" ToolTip="닫기">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round"
                                  Data="M4,4 L10,10 M10,4 L4,10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Header -->
                <StackPanel Grid.Row="1" Margin="28,22,28,0">
                    <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Blink.Txt}"/>
                    <TextBlock Text="이번 업데이트에 포함된 변경 사항입니다" FontSize="12"
                               Foreground="{DynamicResource Blink.TxtFaint}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Notes -->
                <Border Grid.Row="2" Margin="28,16,28,0" CornerRadius="13"
                        Background="{DynamicResource Blink.Inset}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10">
                        <StackPanel x:Name="NotesPanel"/>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="3" Margin="0,16,0,0" Background="{DynamicResource Blink.Surface2}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,1,0,0">
                    <Grid Margin="28,16">
                        <Button Style="{StaticResource PillBtnPrimary}" Content="확인"
                                HorizontalAlignment="Right" MinWidth="96" Click="Close_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
