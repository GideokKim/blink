<!-- Blink.App (WPF, Windows-only). NOT built on macOS — verify on Windows.
     Lists documents whose body wasn't extracted, per configured folder, grouped by reason.
     Chrome mirrors DonateWindow. -->
<Window x:Class="Blink.App.ExtractFailuresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blink — 본문 추출 실패"
        Width="760" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/blink.ico"
        FontFamily="{DynamicResource Blink.Sora}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Blink.TxtDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Blink.RowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Blink.Txt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Margin="20"
            Background="{DynamicResource Blink.Surface}"
            BorderBrush="{DynamicResource Blink.HairlineStrong}" BorderThickness="1"
            TextElement.Foreground="{DynamicResource Blink.Txt}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="14" Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Border CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0" Height="46" Background="{DynamicResource Blink.Titlebar}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="16,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center"
                               Source="pack://application:,,,/blink.ico"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0"
                                   FontSize="13.5" FontWeight="SemiBold">
                            <Run Text="Blink" Foreground="{DynamicResource Blink.Txt}"/><Run Text="  — 본문 추출 실패" Foreground="{DynamicResource Blink.TxtFaint}" FontWeight="Normal"/>
                        </TextBlock>
                        <Button Grid.Column="2" Style="{StaticResource WinBtn}" Click="Close_Click" ToolTip="닫기">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round"
                                  Data="M4,4 L10,10 M10,4 L4,10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="24,16,24,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="FolderPicker" Grid.Row="0" Margin="0,0,0,14"
                              SelectionChanged="FolderPicker_SelectionChanged"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="EmptyText" Text="이 폴더에는 본문 추출 실패가 없습니다."
                                       Foreground="{DynamicResource Blink.TxtDim}" Visibility="Collapsed"/>
                            <ItemsControl x:Name="Groups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Blink.Txt}"/>
                                            <TextBlock Text="{Binding Hint}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Blink.TxtDim}" Margin="0,2,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding DocId}" FontFamily="{DynamicResource Blink.Mono}"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Blink.Txt}"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Blink.TxtFaint}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LimitText" Text="처음 500개만 표시합니다." Visibility="Collapsed"
                                       Foreground="{DynamicResource Blink.TxtFaint}" FontSize="11"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource Blink.Surface2}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14">
                        <TextBlock x:Name="RetryStatus" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Blink.TxtDim}"/>
                        <Button Content="복사" Style="{StaticResource Blink.Pill}" Margin="0,0,8,0" Click="Copy_Click"/>
                        <Button Content="다시 시도" Style="{StaticResource Blink.PillPrimary}" Click="Retry_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
