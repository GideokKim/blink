<!-- Blink.App (WPF, Windows-only). NOT built on macOS — verify on Windows.
     Direction B — "Dual Panel": results list (left) + live document preview (right). -->
<UserControl x:Class="Blink.App.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Blink.App.Controls">
    <Grid Height="460">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="372"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: results list ── -->
        <ListBox x:Name="List" Grid.Column="0"
                 Background="Transparent" BorderThickness="0" Padding="8"
                 ItemsSource="{Binding Results}"
                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="List_SelectionChanged"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseEnter" Handler="Row_MouseEnter"/>
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Row_Click"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowBg" CornerRadius="11" Padding="12,9" Background="Transparent">
                                    <Grid>
                                        <Border x:Name="AccentBar" Width="3" CornerRadius="3"
                                                HorizontalAlignment="Left" Margin="-9,4,0,4"
                                                Background="{DynamicResource Blink.Accent}" Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                                  Color="{DynamicResource Blink.AccentColor}" Opacity="0.9"/>
                                            </Border.Effect>
                                        </Border>
                                        <ContentPresenter/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource Blink.RowSel}"/>
                                        <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ctrl:TileControl Grid.Column="0" TileSize="34" Margin="0,0,12,0"
                                          Glyph="{Binding Glyph}" GlyphBrush="{Binding GlyphBrush}"
                                          IsMono="{Binding GlyphIsMono}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ctrl:HighlightTextBlock SourceText="{Binding Title}" Query="{Binding Query}"
                                                     FontFamily="{DynamicResource Blink.Sora}" FontSize="14"
                                                     FontWeight="Medium" Foreground="{DynamicResource Blink.Txt}"
                                                     TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding BSubtitle}" Margin="0,1,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource Blink.TxtDim}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- content-match dot -->
                        <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center" Margin="8,0,0,0"
                                 Fill="{DynamicResource Blink.Accent}"
                                 Visibility="{Binding ContentHit, Converter={StaticResource Blink.BoolToVis}}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource Blink.AccentColor}" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- vertical divider -->
        <Border Grid.Column="1" Background="{DynamicResource Blink.Hairline}"/>

        <!-- ── Right: preview ── -->
        <Grid Grid.Column="2">
            <!-- empty preview (shown when nothing is selected) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="⌘" FontFamily="{DynamicResource Blink.Mono}" FontSize="44" Opacity="0.5"
                           Foreground="{DynamicResource Blink.TxtFaint}" HorizontalAlignment="Center"/>
                <TextBlock Text="미리보기" Style="{StaticResource Blink.TypeTag}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="항목을 선택하면 상세 정보가 표시됩니다" FontSize="13.5" Margin="0,8,0,0"
                           Foreground="{DynamicResource Blink.TxtFaint}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- populated preview: visibility evaluated on the VM, content on the selected row -->
            <Grid Visibility="{Binding HasSelection, Converter={StaticResource Blink.BoolToVis}}">
            <Grid DataContext="{Binding Selected}" Margin="28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="Auto"/>  <!-- metadata -->
                    <RowDefinition Height="*"/>     <!-- document content -->
                    <RowDefinition Height="Auto"/>  <!-- actions -->
                </Grid.RowDefinitions>

                <!-- header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ctrl:TileControl TileSize="56" Margin="0,0,16,0"
                                      Glyph="{Binding Glyph}" GlyphBrush="{Binding GlyphBrush}"
                                      IsMono="{Binding GlyphIsMono}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Blink.Sora}"
                                   FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Blink.Txt}"/>
                        <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource Blink.Mono}" FontSize="12"
                                   Foreground="{DynamicResource Blink.TxtDim}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- metadata grid -->
                <Border Grid.Row="1" Margin="0,22" Padding="0,16"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,1,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="종류" Style="{StaticResource Blink.TypeTag}"/>
                            <TextBlock Text="{Binding KindLabel}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource Blink.Txt}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="크기" Style="{StaticResource Blink.TypeTag}"/>
                            <TextBlock Text="{Binding SizeOrDash}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource Blink.Txt}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="수정" Style="{StaticResource Blink.TypeTag}"/>
                            <TextBlock Text="{Binding ModOrDash}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource Blink.Txt}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="형식" Style="{StaticResource Blink.TypeTag}"/>
                            <TextBlock Text="{Binding ExtOrDash}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource Blink.Txt}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- document content block (only when indexed content exists) -->
                <StackPanel Grid.Row="2" Visibility="{Binding HasContent, Converter={StaticResource Blink.BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Blink.Accent}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource Blink.AccentColor}" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="문서 내용 일치" Style="{StaticResource Blink.TypeTag}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Blink.BgGlass2}" BorderBrush="{DynamicResource Blink.Hairline}"
                            BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <ItemsControl ItemsSource="{Binding ContentLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:HighlightTextBlock SourceText="{Binding}"
                                                             Query="{Binding DataContext.Query, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                                                             Foreground="{DynamicResource Blink.TxtDim}" Margin="0,0,0,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- action row -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,22,0,0">
                    <Button Style="{StaticResource Blink.PillPrimary}" Margin="0,0,10,0" Click="Open_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="열기" VerticalAlignment="Center" Foreground="{DynamicResource Blink.Txt}"/>
                            <Border Style="{StaticResource Blink.KbdBorder}" Margin="9,0,0,0">
                                <TextBlock Text="↵" Style="{StaticResource Blink.KbdText}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Blink.Pill}" Margin="0,0,10,0" Click="Copy_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="경로 복사" VerticalAlignment="Center" Foreground="{DynamicResource Blink.Txt}"/>
                            <Border Style="{StaticResource Blink.KbdBorder}" Margin="9,0,0,0">
                                <TextBlock Text="⌘C" Style="{StaticResource Blink.KbdText}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Blink.Pill}" Click="Reveal_Click"
                            Visibility="{Binding HasContent, Converter={StaticResource Blink.BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Finder에서 보기" VerticalAlignment="Center" Foreground="{DynamicResource Blink.Txt}"/>
                            <Border Style="{StaticResource Blink.KbdBorder}" Margin="9,0,0,0">
                                <TextBlock Text="⌘↵" Style="{StaticResource Blink.KbdText}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
