<!-- Blink.App (WPF, Windows-only). NOT built on macOS — verify on Windows.
     Shared launcher shell: translucent glass panel, search row, body (A/B), footer.
     Color tokens are DynamicResource Blink.* (published by ThemeManager). -->
<Window x:Class="Blink.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blink"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="640"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- Outer margin leaves room for the soft drop shadow. -->
    <Grid Margin="44,40,44,52">
        <Border x:Name="GlassPanel" CornerRadius="20"
                Background="{DynamicResource Blink.BgGlass}"
                BorderBrush="{DynamicResource Blink.HairlineStrong}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="90" ShadowDepth="20" Direction="270" Opacity="0.62" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <!-- entrance: translateY(7) scale(.992) → none -->
                <TransformGroup>
                    <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PopTranslate" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- search row -->
                    <RowDefinition Height="Auto"/>  <!-- divider -->
                    <RowDefinition Height="Auto"/>  <!-- body (A/B) -->
                    <RowDefinition Height="Auto"/>  <!-- footer -->
                </Grid.RowDefinitions>

                <!-- ── Search row (64px) ── -->
                <Grid Grid.Row="0" Height="64" Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- magnifier glyph (stroke 1.8) -->
                    <Viewbox Grid.Column="0" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Canvas Width="22" Height="22">
                            <Path Stroke="{DynamicResource Blink.TxtFaint}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                  Data="M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 Z M14.5,14.5 L20,20"/>
                        </Canvas>
                    </Viewbox>

                    <!-- input + placeholder overlay -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False"
                                   Text="Blink — 앱, 파일, 문서 내용 검색…"
                                   FontFamily="{DynamicResource Blink.Sora}" FontSize="21"
                                   Foreground="{DynamicResource Blink.TxtFaint}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 CaretBrush="{DynamicResource Blink.Accent}"
                                 FontFamily="{DynamicResource Blink.Sora}" FontSize="21"
                                 Foreground="{DynamicResource Blink.Txt}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    </Grid>

                    <!-- right slot: esc chip (A) / count (B) -->
                    <Border x:Name="EscChip" Grid.Column="2" Style="{StaticResource Blink.KbdBorder}"
                            Visibility="Collapsed">
                        <TextBlock Text="esc" Style="{StaticResource Blink.KbdText}"/>
                    </Border>
                    <TextBlock x:Name="CountLabel" Grid.Column="2" Style="{StaticResource Blink.MonoFaint}"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- divider -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource Blink.Hairline}"/>

                <!-- body: ClassicView or SplitView injected in code-behind -->
                <ContentControl x:Name="Body" Grid.Row="2"/>

                <!-- ── Footer ── -->
                <Border Grid.Row="3" Background="{DynamicResource Blink.BgGlass2}"
                        BorderBrush="{DynamicResource Blink.Hairline}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,20,20">
                    <Grid Margin="20,11">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource Blink.Accent}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource Blink.AccentColor}" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="FooterCaption" Margin="8,0,0,0" Style="{StaticResource Blink.MonoFaint}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Update-available badge: hidden until App.OnUpdateAvailable calls SetUpdateAvailable. -->
                            <Border x:Name="UpdateBadge" Style="{StaticResource Blink.ContentBadge}"
                                    Margin="0,0,14,0" Cursor="Hand" Visibility="Collapsed"
                                    MouseLeftButtonUp="UpdateBadge_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬆" FontSize="11" Margin="0,0,4,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Blink.Accent}"/>
                                    <TextBlock x:Name="UpdateBadgeText" Style="{StaticResource Blink.MonoFaint}"
                                               Foreground="{DynamicResource Blink.Accent}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Style="{StaticResource Blink.KbdBorder}" Margin="0,0,4,0">
                                    <TextBlock Text="↑" Style="{StaticResource Blink.KbdText}"/>
                                </Border>
                                <Border Style="{StaticResource Blink.KbdBorder}" Margin="0,0,6,0">
                                    <TextBlock Text="↓" Style="{StaticResource Blink.KbdText}"/>
                                </Border>
                                <TextBlock Text="이동" Style="{StaticResource Blink.MonoFaint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Blink.KbdBorder}" Margin="0,0,6,0">
                                    <TextBlock Text="↵" Style="{StaticResource Blink.KbdText}"/>
                                </Border>
                                <TextBlock Text="열기" Style="{StaticResource Blink.MonoFaint}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
