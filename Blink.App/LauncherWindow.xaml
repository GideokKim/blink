<!-- Blink.App (WPF, Windows-only). NOT built on macOS — verify on Windows. -->
<Window x:Class="Blink.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blink"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#FFFFFFFF"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="Manual">
    <!-- Backdrop/acrylic applied at runtime via AcrylicHelper on SourceInitialized.
         #111111 text is used throughout for legibility over the translucent backdrop. -->
    <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="12" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search box -->
            <TextBox x:Name="SearchBox" Grid.Row="0"
                     FontSize="22" Foreground="#111111"
                     BorderThickness="0" Background="Transparent"
                     Padding="6" TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>

            <!-- Results -->
            <ListBox x:Name="ResultsList" Grid.Row="1"
                     Margin="0,10,0,0" MaxHeight="460"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ResultsList_SelectionChanged"
                     ScrollViewer.ScrollChanged="ResultsList_ScrollChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding DisplayText}" FontSize="16" Foreground="#111111"/>
                            <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="#666666"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- Inline match lines, shown only for the selected row -->
                            <ItemsControl ItemsSource="{Binding MatchLines}" Margin="12,4,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#333333"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding LineNo}" Foreground="#999999"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Text}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer toast -->
            <Border x:Name="Toast" Grid.Row="2" Margin="0,8,0,0"
                    Background="#EE222222" CornerRadius="6" Padding="10,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Foreground="#FFFFFF" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
